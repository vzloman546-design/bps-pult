name = "turnstile-inspection-api"
main = "src/worker.js"
compatibility_date = "2026-09-26"

[vars]
# После создания Cloudflare Pages здесь будет реальный *.pages.dev origin.
# Можно перечислить несколько origin через запятую на период миграции.
ALLOWED_ORIGIN = "https://REPLACE.pages.dev"
SESSION_TTL_DAYS = "30"
PUBLIC_APP_URL = "https://REPLACE.pages.dev"

# Публичная часть VAPID-ключа. Приватная хранится только как secret.
VAPID_PUBLIC_KEY = "REPLACE_VAPID_PUBLIC_KEY"
VAPID_SUBJECT = "https://REPLACE.pages.dev"

[[d1_databases]]
binding = "DB"
database_name = "turnstile-inspection"
database_id = "REPLACE_D1_DATABASE_ID"

[[kv_namespaces]]
binding = "DOCUMENTS"
id = "REPLACE_KV_NAMESPACE_ID"

[[durable_objects.bindings]]
name = "INSPECTION_ROOM"
class_name = "InspectionRoom"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["InspectionRoom"]

# Secrets, которые задаются через wrangler secret put и никогда не коммитятся:
# SESSION_PEPPER      - случайная строка для хеширования токенов сессий
# PASSWORD_PEPPER     - отдельная случайная строка для паролей
# BOOTSTRAP_TOKEN     - одноразовая защита первого администратора
# VAPID_PRIVATE_KEY   - приватная часть ключа Web Push


[browser]
binding = "BROWSER"
